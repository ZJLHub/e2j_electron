{
  "name": "cocos-electron-ts",
  "version": "1.0.0",
  "main": "dist/main/main.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "start": "electron .",
    "dist": "npm run build && electron-builder"
  },
  "devDependencies": {
    "@types/electron": "^1.6.10",
    "@types/node": "^20.9.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.9.1",
    "typescript": "^5.2.2"
  },
  "build": {
    "appId": "com.your.cocosapp",
    "productName": "CocosElectronApp",
    "directories": {
      "output": "release"
    },
    "win": {
      "target": "nsis",
      "icon": "resource/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
