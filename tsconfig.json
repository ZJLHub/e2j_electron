{
  "compilerOptions": {
    "target": "ES6", // 编译目标 ES 版本
    "module": "CommonJS", // 输出 CommonJS 模块（兼容现有 JS 代码）
    "outDir": "./dist", // 编译后的 JS 文件输出目录
    "rootDir": "./src", // TS 源文件根目录
    "strict": false, // 开启严格类型检查
    "esModuleInterop": true, // 允许 CommonJS 和 ESM 互操作
    "skipLibCheck": true, // 跳过库类型检查
    "forceConsistentCasingInFileNames": true, // 强制文件名大小写一致
    "types": [
      "node",
      "electron"
    ] // 引入 Node 和 Electron 类型
  },
  "include": [
    "src/**/*", // 主进程代码
    "renderer/**/*" // 新增：包含 renderer 目录下的 TS 文件
  ], // 需编译的文件
  "exclude": [
    "node_modules",
    "dist"
  ] // 排除目录
}